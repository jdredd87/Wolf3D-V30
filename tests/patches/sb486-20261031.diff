+//
+// The network gone quiet (2026-10-31, StevenC & Claude): the 486's PicoMEM 1
+// stops receiving now and then with its Sound Blaster playing -- the game
+// goes on and sends, nothing comes in -- and past the server's 60 s it was
+// dropped, every few hours.  The watchdog build, which writes a line to
+// HANG.LOG on the card's own disk 20 s into such a spell, was never dropped
+// in 33 hours: its spells ended.  So after 20 s with nothing in, a line goes
+// to NETQUIET.LOG, and another when the network is back; the report counts
+// them.
+//
+long	far	netquiets = 0, far netquietmax = 0;	// spells, and the longest (s)
+
+static void QuietLog (char far *fmt, long a, long b)
+{
+	static char far name[] = "NETQUIET.LOG";
+	char		nm[14], f[48], s[64];
+	int			h;
+	unsigned	w;
+
+	_fstrcpy ((char far *)nm,name);
+	_fstrcpy ((char far *)f,fmt);
+	sprintf (s,f,a,b);
+	if (_dos_open (nm,O_WRONLY,&h) && _dos_creat (nm,0,&h))
+		return;
+	lseek (h,0L,SEEK_END);
+	_dos_write (h,(char far *)s,strlen (s),&w);
+	_dos_close (h);
+}
+
+static void NetQuiet (void)
+{
+	static char far fq[] = "quiet: nothing in for 20 s (%ld in, %ld out)\r\n",
+		far fb[] = "back after %ld s (%ld in)\r\n";
+	static long far lastn = -1, far lastt;
+	static int far quiet;
+	long	t = *(long far *)MK_FP (0x40,0x6c);	// the BIOS tick, 18.2 a second
+
+	if (netrecvn != lastn)
+	{
+		if (quiet)
+		{
+			long s = (t - lastt) * 10 / 182;
+
+			if (s > netquietmax)
+				netquietmax = s;
+			QuietLog (fb,s,netrecvn);
+			quiet = 0;
+		}
+		lastn = netrecvn;
+		lastt = t;
+	}
+	else if (netrecvn && !quiet && t - lastt >= 20 * 182L / 10)
+	{
+		quiet = 1;
+		netquiets++;
+		QuietLog (fq,netrecvn,netsentn);
+	}
+}
