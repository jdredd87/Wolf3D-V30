@@ -52,8 +52,24 @@ boolean	MPHear (void);		// WL_MP.C: multiplayer, near enough to hear?
 // Macros for SoundBlaster stuff
 #define	sbOut(n,b)	outportb((n) + sbLocation,b)
 #define	sbIn(n)		inportb((n) + sbLocation)
-#define	sbWriteDelay()	while (sbIn(sbWriteStat) & 0x80);
-#define	sbReadDelay()	while (sbIn(sbDataAvail) & 0x80);
+// NEC V30 build (2026-10-29, StevenC & Claude): every wait on the DSP
+// bounded.  id's waited for the DSP's status bit with no limit, and most of
+// the waits are made with interrupts off (SDL_SBStopSample, SDL_SBPlaySeg,
+// SDL_SBPlaySample): a DSP that stayed busy froze the whole machine -- no
+// tick, no network, no report.  The 486 hung with its Sound Blaster on
+// (twice in 30 hours, once 47 minutes in) and never with NOSB (48 hours).
+// 16384 reads is milliseconds on any bus; past it the command is sent
+// anyway, and sbstuck counts it (the network game's report says so).
+unsigned	sbstuck;
+
+// TEST (2026-10-31, StevenC & Claude): a pause before and after each burst of
+// DSP commands, as the watchdog build's HangMark makes there by repainting
+// its code through the VGA's ports -- the 486 froze with its Sound Blaster
+// on, on the release build, every few hours, and never on the watchdog build
+// (33 hours).  32 reads of the VGA's input status: tens of microseconds.
+#define	sbPause()	{int sbp_; for (sbp_ = 0;sbp_ < 32;sbp_++) inportb(0x3da);}
+#define	sbWriteDelay()	{unsigned sbw_ = 16384; while ((sbIn(sbWriteStat) & 0x80) && --sbw_); if (!sbw_) sbstuck++;}
+#define	sbReadDelay()	{unsigned sbw_ = 16384; while ((sbIn(sbDataAvail) & 0x80) && --sbw_); if (!sbw_) sbstuck++;}
 
 // Macros for AdLib stuff
 #define	selreg(n)	outportb(alFMAddr,n)
